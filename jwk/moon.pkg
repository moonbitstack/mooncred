// JSON Web Key, RFC 7517: https://www.rfc-editor.org/rfc/rfc7517
// Key parameters by type, RFC 7518 §6: https://www.rfc-editor.org/rfc/rfc7518#section-6
// Octet key pairs, RFC 8037 §2: https://www.rfc-editor.org/rfc/rfc8037#section-2
//
// Reading and writing the format, and choosing a key out of a set. Turning the
// material into something that can sign belongs to the program, which knows
// which algorithms it wants linked.
import {
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonjson/json",
}

import {
  "moonbitstack/moonbase/base16",
  "moonbitstack/mooncrypt/sign/ed25519",
} for "test"
