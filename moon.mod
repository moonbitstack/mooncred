name = "moonbitstack/mooncred"

version = "0.6.10"

readme = "README.md"

repository = "https://github.com/moonbitstack/mooncred"

license = "Apache-2.0"

keywords = [
  "jwt",
  "jws",
  "jwe",
  "jwk",
  "jose",
  "cose",
  "cwt",
  "cbor",
  "token",
  "credential",
  "x509",
  "certificate",
  "csr",
  "pkcs10",
  "pkcs8",
  "pkcs12",
  "pfx",
  "pem",
  "crl",
  "ocsp",
  "revocation",
  "root-certificates",
  "pbe",
  "oauth2",
  "rfc7519",
  "rfc5280",
  "rfc9881",
  "ml-dsa",
  "dilithium",
  "post-quantum",
  "post-quantum-cryptography",
  "fips204",
  "moonbit",
]

description = "Credentials for MoonBit: JWT, JWK and X.509."

import {
  "moonbitstack/moonbase@0.4.3",
  "moonbitstack/mooncrypt@0.4.12",
  "moonbitstack/moondate@0.1.5",
  "moonbitstack/moonjson@0.4.3",
}

source = "src"
