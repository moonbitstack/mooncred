name = "moonbitstack/mooncred"

version = "0.6.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/mooncred"

license = "Apache-2.0"

keywords = [
  "jwt",
  "jws",
  "jwk",
  "jose",
  "token",
  "credential",
  "x509",
  "certificate",
  "oauth2",
  "moonbit",
]

description = "Credentials for MoonBit: JWT, JWK and X.509."

import {
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/mooncrypt@0.4.2",
  "moonbitstack/moonjson@0.4.0",
}

source = "src"
